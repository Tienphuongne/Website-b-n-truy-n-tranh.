Options -Indexes
RewriteEngine On

RewriteRule ^(?:configs|controllers|models|views|database)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^assets/uploads/.*\.(?:php[0-9]?|phtml)$ - [F,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
