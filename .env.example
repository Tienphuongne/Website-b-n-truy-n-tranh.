# Sao chép sang .env và chỉnh sửa cho môi trường của bạn.
# .env đã nằm trong .gitignore, không đẩy API key lên Git.

# Để trống để tự nhận diện URL theo môi trường chạy.
# APP_BASE_URL=http://localhost/website-ban-truyen-tranh/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=manga_house

# Chatbot AI (Gemini). Lấy key miễn phí: https://aistudio.google.com/app/apikey
# Để trống AI_API_KEY nếu muốn chạy chế độ dự phòng (không cần API).
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Model thay thế (phân cách bằng dấu phẩy) khi model chính quá tải.
AI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-latest
